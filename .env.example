# Where Ollama listens. Default is fine when Ollama runs locally.
# If Ollama is on another machine, set the full URL: http://hostname:11434
OLLAMA_HOST=http://localhost:11434

# ─── YouTube data provider ───────────────────────────────────────────────────
# Which backend serves YouTube data (peer + own-channel uploads, title CTR
# scoring, performance analytics). Pick ONE; uncomment and fill its API key.
#
#   vidiq    (recommended) — direct VidIQ MCP. Paid VidIQ account required.
#                            Unlocks `engine sync-performance` (auto analytics).
#   composio (legacy)      — Composio toolkit. NOT recommended post-2026 breach.
#                            See docs/SECURITY.md for the migration history.
#   noop                   — run the engine without YouTube signal (Reddit,
#                            HN, RSS, and GitHub releases still flow).
YOUTUBE_PROVIDER=vidiq

# Get yours from https://app.vidiq.com (Settings → API / Integrations).
# VIDIQ_API_KEY=

# Optional override if you self-host VidIQ's MCP or proxy it.
# VIDIQ_MCP_ENDPOINT=https://mcp.vidiq.com/mcp

# Legacy fallback. Get from https://app.composio.dev → Settings → API Keys.
# Run `engine composio-disconnect` if you previously had Composio set up and
# want to scrub the local credential cache after migrating to VidIQ.
# COMPOSIO_API_KEY=
